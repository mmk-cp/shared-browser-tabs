APP_ENV=development
# Docker Compose hard RAM cap; memory+swap use is capped at the same value.
APP_MEMORY_LIMIT=3g
SECRET_KEY=change-this-in-production
DATABASE_URL=sqlite:///./data/app.db
BROWSER_DATA_DIR=/browser-data/chromium-profile
BROWSER_HEADLESS=false
BROWSER_CONNECT_OVER_CDP=true
BROWSER_DEBUG_PORT=9222
BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
BROWSER_FPS=15
BROWSER_JPEG_QUALITY=70
DEFAULT_WIDTH=1600
DEFAULT_HEIGHT=900
VNC_BASE_PORT=5900
VNC_VIEW_WIDTH=1600
VNC_VIEW_HEIGHT=900
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
COOKIE_SECURE=false
